#!/usr/bin/env bash
# Emit one row per running codex CLI session that lives in a tmux pane.
# Status comes from tmux pane options (@codex_state) written by
# codex-session-state, wired into ~/.codex/hooks.json -- codex has no
# `agents --json` equivalent, only lifecycle hooks, so this is push- not
# pull-based. See codex-session-state for what event firing is verified.
#
# Unlike Claude (a Node process that renames itself on macOS, see
# claude-agent-rows), codex is a native binary and pane_current_command
# reports it directly -- no pid/tty join needed to find the pane. But the
# actual codex pid (for ai-session-manager's kill bind) still needs one:
# pane_pid is the pane's shell, and codex is its direct child.
#
#   Row: sortkey \t pane_id \t pid \t display
#   Same display format, sortkey packing, and hidden-field convention as
#   claude-agent-rows, so ai-session-manager can merge both lists and sort
#   them together.

{
  ai-frecency-scores
  ps -Ao pid=,ppid=,comm= 2>/dev/null | awk '{ print "C\t" $1 "\t" $2 "\t" $3 }'
  tmux list-panes -a -F $'T\t#{pane_id}\t#{pane_pid}\t#{@codex_state}\t#{pane_current_command}\t#{pane_current_path}\t#{window_activity}' 2>/dev/null
} | awk -F'\t' -v dirlen=2 -v titlew=32 '
  # Clamped so an unscored cwd sorts last within its rank rather than first,
  # and so a runaway score cannot overflow into the rank digits.
  function invfrec(dir) {
    score = (dir in frec) ? frec[dir] : 0
    if (score > 99999) score = 99999
    return 99999 - score
  }

  $1 == "F" { frec[$2] = $3; next }
  $1 == "C" { if ($4 == "codex") codex_pid_of[$3] = $2; next }   # ppid -> child codex pid
  $1 == "T" {
    if ($5 != "codex") next   # not a codex pane

    pid = codex_pid_of[$3]
    if (pid == "") next       # pane_current_command lagged behind an exited codex

    state = $4   # unset until the first hook fires (lazy SessionStart) -- treat as idle

    if      (state == "waiting") { color = "\033[33m"; label = "waiting"; rank = 0 }  # yellow - needs input
    else if (state == "working") { color = "\033[31m"; label = "working"; rank = 3 }  # red    - busy, leave it
    else                          { color = "\033[32m"; label = "idle";    rank = 1 }  # green  - idle/unset

    # short path: last N segments only, same idea as sesh dir_length=2
    n = split($6, parts, "/")
    short = parts[n]
    for (i = 1; i < dirlen && n - i >= 1; i++) short = parts[n - i] "/" short

    # nerd-font glyph for OpenAI (cod-openai, U+EC81) -- codex has no glyph
    # of its own, this is the closest brand mark. Static, not verified
    # against every font -- renders as tofu if the terminal font lacks it.
    logo = "\xee\xb2\x81"

    display = sprintf("%s %s●\033[0m %-7s %-*s %s", logo, color, label, titlew, "codex", short)

    sortkey = rank * 1000000000000000 + invfrec($6) * 10000000000 + (9999999999 - $7)

    printf "%s\t%s\t%s\t%s\n", sortkey, $2, pid, display
  }
' | sort -t$'\t' -k1,1n
