#!/usr/bin/env bash
# Emit one row per running Claude Code session that lives in a tmux pane.
# Status ("busy"/"idle"/"waiting") comes straight from `claude agents --json` --
# no text scraping of the pane (pane_current_command reports the parent shell
# on macOS, never the claude child running inside it).
#
# Identity is the claude process (by pid -> tty), not the tmux pane, so several
# Claudes in one window/session each still get their own row.
#
#   Row: sortkey \t pane_id \t pid \t display
#   sortkey/pane_id/pid are hidden from the display via fzf's --with-nth.
#   pid is the actual claude process (already known from the --json join),
#   used by ai-session-manager's kill bind. display is one pre-padded
#   string (spaces, not tabs) so title/location line up in
#   fixed columns regardless of length -- fzf's --with-nth rejoins fields
#   using the field delimiter itself, and a raw tab there just lands wherever
#   the terminal's next 8-column tab stop happens to be.
#
#   sortkey packs rank and recency into one ascending numeric sort: rank in
#   the billions place (needs-you floats up), window_activity (tmux's free
#   last-output timestamp, no extra instrumentation) inverted as the
#   tiebreaker so the most recently active pane sorts first within a rank.
#
# `claude agents --json` only gives a short session slug (e.g. "dot-4e"), not
# the task summary -- that only exists as the pane's terminal title, which
# Claude sets itself (e.g. "✳ Wiz sensor chart upgrade"). Pull it from tmux.
#
# Codex and copilot are now covered too -- see their own *-agent-rows and
# *-session-state scripts. Neither has an `agents --json` equivalent, but
# both have lifecycle hooks (~/.codex/hooks.json, ~/.copilot/hooks/hooks.json),
# verified working 2026-08-20/2026-08-24 against codex-cli 0.148.0 and
# copilot-cli 1.0.80.
#
# TODO: fold opencode into ai-session-manager too. Checked 2026-08-24
# (opencode 1.17.19) -- no live-process status API, but it does have an
# in-process JS plugin system (~/.config/opencode/plugins/*/plugin.js,
# events like session.created/session.idle/tui.prompt.append) rather than
# a hooks.json + subprocess like the other three. This repo already has a
# working example plugin (~/.config/opencode/plugins/caveman/plugin.js) to
# copy the pattern from.

agents="$(claude agents --json 2>/dev/null)" || exit 0
rows="$(printf '%s' "$agents" \
  | jq -r '.[] | select(.kind == "interactive") | [.pid, .status, .cwd] | @tsv' 2>/dev/null)"
[[ -n "$rows" ]] || exit 0

{
  ps -Ao pid=,tty= 2>/dev/null | awk '{ print "P\t" $1 "\t" $2 }'
  tmux list-panes -a -F $'T\t#{pane_tty}\t#{pane_id}\t#{pane_title}\t#{window_activity}' 2>/dev/null
  printf '%s\n' "$rows" | sed $'s/^/A\t/'
} | awk -F'\t' -v dirlen=2 -v titlew=32 '
  $1 == "P" { tty_of[$2] = $3; next }
  $1 == "T" {
    sub(/^\/dev\//, "", $2)
    pane[$2] = $3
    title = $4
    sub(/^✳ /, "", title)
    ttl[$2] = title
    act[$2] = $5
    next
  }
  $1 == "A" {
    tty = tty_of[$2]
    if (tty == "" || !(tty in pane)) next   # this claude is not running inside tmux

    if      ($3 == "waiting") { color = "\033[33m"; label = "waiting"; rank = 0 }  # yellow - needs input
    else if ($3 == "idle")    { color = "\033[32m"; label = "idle";    rank = 1 }  # green  - done, your turn
    else if ($3 == "busy")    { color = "\033[31m"; label = "working"; rank = 3 }  # red    - busy, leave it
    else                      { color = "\033[90m"; label = "?";       rank = 2 }  # grey   - unrecognised status

    # short path: last N segments only, same idea as sesh dir_length=2
    n = split($4, parts, "/")
    short = parts[n]
    for (i = 1; i < dirlen && n - i >= 1; i++) short = parts[n - i] "/" short

    title = ttl[tty]
    if (length(title) > titlew) title = substr(title, 1, titlew - 1) "…"

    # nerd-font glyph for Claude (cod-claude, U+EC82). Static, not verified
    # against every font -- renders as tofu if the terminal font lacks it.
    logo = "\xee\xb2\x82"

    display = sprintf("%s %s●\033[0m %-7s %-*s %s", logo, color, label, titlew, title, short)

    sortkey = rank * 10000000000 + (9999999999 - act[tty])

    printf "%s\t%s\t%s\t%s\n", sortkey, pane[tty], $2, display
  }
' | sort -t$'\t' -k1,1n
